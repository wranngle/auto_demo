{
  "name": "auto_demo",
  "version": "0.2.0",
  "description": "Record browser UI demos: replay deterministic JSON flows or capture with an AI agent. No hosted login required.",
  "type": "module",
  "bin": {
    "auto_demo": "./dist/cli.js"
  },
  "files": [
    "dist",
    "assets",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "xo src tests",
    "package:smoke": "npm run build && npm pack --dry-run",
    "prepare": "npm run build",
    "demo:smoke": "npm run build && node dist/cli.js run examples/local-smoke.demo.json --output .work/smoke-demo",
    "demo:capture": "npm run build && node dist/cli.js capture http://127.0.0.1:5180/smoke.html --prompt 'Open Opportunity Review from the left nav, search for voice automation, then call done.' --output .work/capture-demo"
  },
  "keywords": [
    "browser-automation",
    "demo-recording",
    "playwright",
    "screen-recording",
    "ui-automation",
    "ai-agent"
  ],
  "author": "Cody Arnold",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "arktype": "^2.1.27",
    "commander": "^14.0.2",
    "playwright": "^1.57.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/uuid": "^10.0.0",
    "eslint-config-xo-typescript": "^7.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15",
    "xo": "^2.0.2"
  },
  "xo": {
    "prettier": false,
    "space": 2,
    "semicolon": true,
    "rules": {
      "@typescript-eslint/consistent-type-definitions": "off"
    }
  }
}
