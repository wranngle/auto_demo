#!/usr/bin/env bash
# git-wip-gc -- inspect or delete stale wip/* refs.
set -euo pipefail

ttl_days=30
remote=origin
apply=0
include_legacy=0
no_pr_check=0
repo=.

usage(){
  cat <<'USAGE'
Usage: git-wip-gc [--repo PATH] [--ttl-days N] [--remote origin] [--apply] [--include-legacy] [--no-pr-check]

Default is dry-run. Output is NDJSON.
USAGE
}

while [[ $# -gt 0 ]];do
  case "$1" in
    --repo) repo=${2:-}; shift 2;;
    --ttl-days) ttl_days=${2:-}; shift 2;;
    --remote) remote=${2:-}; shift 2;;
    --apply) apply=1; shift;;
    --include-legacy) include_legacy=1; shift;;
    --no-pr-check) no_pr_check=1; shift;;
    -h|--help) usage; exit 0;;
    *) repo=$1; shift;;
  esac
done

command -v jq >/dev/null 2>&1 || { printf '{"check":"prereq","outcome":"fail","message":"jq is required"}\n'; exit 2; }
root=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null || true)
[[ -n "$root" ]] || { printf '{"check":"repo","outcome":"fail","message":"not a git repository"}\n'; exit 2; }

now=$(date +%s)
ttl_seconds=$((ttl_days * 86400))
status=0

open_pr_heads(){
  local remote_url slug
  remote_url=$(git -C "$root" remote get-url "$remote" 2>/dev/null || true)
  [[ "$remote_url" == *github.com* ]] || return 2
  case "$remote_url" in
    git@github.com:*) slug=${remote_url#git@github.com:};;
    https://github.com/*) slug=${remote_url#https://github.com/};;
    ssh://git@github.com/*) slug=${remote_url#ssh://git@github.com/};;
    *) return 2;;
  esac
  slug=${slug%.git}
  if command -v gh >/dev/null 2>&1 && [[ -n "$slug" ]];then
    gh repo view --repo "$slug" --json nameWithOwner >/dev/null || return 2
    gh pr list --repo "$slug" --state open --limit 200 --json headRefName --jq '.[].headRefName'
  else
    return 2
  fi
}

pr_check_available=0
pr_check_complete=0
open_head_count=0
if open_heads=$(open_pr_heads 2>/dev/null | awk 'NF' | sort -u);then
  pr_check_available=1
  open_head_count=$(awk 'NF { count++ } END { print count + 0 }' <<<"$open_heads")
  if (( open_head_count < 200 ));then
    pr_check_complete=1
  fi
else
  open_heads=
fi

is_open_pr_head(){
  local branch=$1
  grep -Fxq "$branch" <<<"$open_heads"
}

emit(){
  local branch=$1 ref=$2 age_days=$3 action=$4 outcome=$5 message=$6 kind=$7
  jq -nc \
    --arg branch "$branch" \
    --arg ref "$ref" \
    --arg action "$action" \
    --arg outcome "$outcome" \
    --arg message "$message" \
    --arg kind "$kind" \
    --argjson age_days "$age_days" \
    '{branch:$branch,ref:$ref,kind:$kind,age_days:$age_days,action:$action,outcome:$outcome,message:$message}'
}

wip_ref_kind(){
  local branch=$1
  if [[ "$branch" =~ ^wip/[^/]+/[^/]+/[^/]+$ && "$branch" != wip/local/* ]];then
    printf canonical
  else
    printf legacy
  fi
}

while IFS=$'\t' read -r ref unix_time;do
  [[ -n "$ref" && -n "$unix_time" ]] || continue
  age=$((now - unix_time))
  (( age >= ttl_seconds )) || continue
  age_days=$((age / 86400))
  branch=${ref#refs/remotes/$remote/}
  branch=${branch#refs/heads/}
  kind=$(wip_ref_kind "$branch")
  if is_open_pr_head "$branch";then
    emit "$branch" "$ref" "$age_days" skip pass "open PR still references branch" "$kind"
    continue
  fi
  if (( apply && ( pr_check_available == 0 || pr_check_complete == 0 ) && no_pr_check == 0 ));then
    emit "$branch" "$ref" "$age_days" skip warn "PR liveness check unavailable; deletion refused without --no-pr-check" "$kind"
    continue
  fi
  if [[ "$kind" == legacy && $include_legacy == 0 ]];then
    emit "$branch" "$ref" "$age_days" skip warn "legacy wip ref requires explicit --include-legacy before deletion" "$kind"
    continue
  fi
  if (( apply ));then
    if [[ "$ref" == refs/remotes/* ]];then
      if git -C "$root" push "$remote" --delete "$branch" >/dev/null 2>&1;then
        emit "$branch" "$ref" "$age_days" delete pass "deleted remote wip ref" "$kind"
      else
        emit "$branch" "$ref" "$age_days" delete fail "failed to delete remote wip ref" "$kind"
        status=1
      fi
    else
      if git -C "$root" branch -D "$branch" >/dev/null 2>&1;then
        emit "$branch" "$ref" "$age_days" delete pass "deleted local wip ref" "$kind"
      else
        emit "$branch" "$ref" "$age_days" delete fail "failed to delete local wip ref" "$kind"
        status=1
      fi
    fi
  else
    emit "$branch" "$ref" "$age_days" dry-run pass "stale wip ref candidate" "$kind"
  fi
done < <(
  {
    git -C "$root" for-each-ref --format='%(refname)%09%(committerdate:unix)' "refs/remotes/$remote/wip" 2>/dev/null || true
    git -C "$root" for-each-ref --format='%(refname)%09%(committerdate:unix)' refs/heads/wip 2>/dev/null || true
  } | awk 'NF'
)

exit "$status"
