# ui-demo-runner CI integration: re-record your golden demo on every deploy.
#
# Copy this file to `.github/workflows/ui-demo-runner-on-deploy.yml` and edit
# the placeholders marked CONSUMER:. The workflow installs ui-demo-runner via
# npx, replays the named .demo.json flow, and uploads the webm + manifest
# artifacts alongside the run so reviewers can scrub the demo without a local
# checkout.

name: ui-demo-runner on deploy

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  record:
    runs-on: ubuntu-latest
    timeout-minutes: 15

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install Playwright browsers
        run: npx --yes playwright@1.57.0 install --with-deps chromium

      # ffmpeg is NOT preinstalled on ubuntu-latest. Without it the recording
      # still succeeds but ships stretched 3-5x slow-motion (the runner's
      # real-time retime is skipped) — install it so CI artifacts play right.
      - name: Install ffmpeg
        run: |
          sudo apt-get update -qq
          sudo apt-get install -y -qq ffmpeg

      - name: Record demo
        # CONSUMER: plain `run` needs no secrets. Export ELEVENLABS_API_KEY
        # here only if you chain `narrate --voice elevenlabs` onto the
        # recording in a later step.
        # CONSUMER: once ui-demo-runner is published to npm, shorten the
        # install spec below to just `ui-demo-runner`.
        run: |
          npx --yes ui-demo-runner@github:wranngle/auto_demo run \
            flows/golden.demo.json \
            --output .ui-demo-runner/ci

      - name: Upload demo artifacts
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: ui-demo-runner-${{ github.sha }}
          path: |
            .ui-demo-runner/ci/recording.webm
            .ui-demo-runner/**/manifest.json
            .ui-demo-runner/**/events.jsonl
          if-no-files-found: error
          retention-days: 30
